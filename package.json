{
  "name": "fresamobile",
  "version": "1.1.3",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "clear-cache": "rm -rf node_modules/.cache .expo && echo 'Expo/Metro cache cleared. Run npm start to start fresh.'",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios:testflight": "eas build --profile testflight --platform ios",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "build:ios:production": "eas build --profile production --platform ios",
    "build:android:apk": "eas build --profile android-apk --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "build:all:preview": "eas build --profile preview --platform all",
    "build:all:production": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "build:list": "eas build:list",
    "build:view": "eas build:view"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/elements": "^2.8.2",
    "@reduxjs/toolkit": "^2.3.0",
    "expo": "~54.0.24",
    "expo-av": "~16.0.7",
    "expo-constants": "~18.0.0",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "~6.0.18",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.7",
    "expo-image-picker": "^17.0.10",
    "expo-linking": "~8.0.0",
    "expo-media-library": "~18.2.0",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "libphonenumber-js": "^1.12.31",
    "moment": "^2.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-international-phone-number": "^0.11.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
