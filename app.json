{
  "expo": {
    "name": "Fresa Health",
    "slug": "FresaMobile",
    "version": "1.1.4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "fresamobile",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fresahealth.mobile",
      "companyName": "FresaHealth GmbH",
      "displayName": "Fresa Health",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record voice feedback.",
        "NSContactsUsageDescription": "This app needs access to your contacts to detect your phone number.",
        "NSCameraUsageDescription": "This app needs access to your camera to take profile photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select profile photos.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Fresa Health",
        "CFBundleName": "Fresa Health"
      },
      "notification": {
        "icon": "./assets/icon.png",
        "color": "#F6B8A3"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fresahealth.mobile",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA"
      ],
      "notification": {
        "icon": "./assets/icon.png",
        "color": "#F6B8A3",
        "sounds": []
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F6B8A3",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70e75a09-e301-4cf9-8707-fefd3424c741"
      }
    }
  }
}
